DATABASE_URL="postgresql://user:password@localhost:5432/sknfolio?schema=public"

PORT=3001
# CLIENT_URL is where the magic-link redirect sends people after sign-in.
# Keep it as-is for local dev (the separate Vite server). In a single-service
# deploy it also self-detects from the request if left blank, so you can
# clear this value there too instead of setting it by hand.
CLIENT_URL="http://localhost:5173"
# SERVER_URL is an optional override, normally not needed. Locally it defaults
# to http://localhost:$PORT. In a single-service deploy (e.g. Replit, where
# this server also serves the built client) it self-detects your app's public
# URL from the incoming request, so you don't need to set this by hand there
# either — only set it if you're running behind a proxy that hides the real
# host/protocol from the server.
SERVER_URL=
SESSION_COOKIE_NAME="sknfolio_session"
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15

# SMTP is optional in development. If unset, magic links are logged to the
# server console instead of being emailed, so you can log in without a mail
# server configured.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SKNFOLIO <hello@sknfolio.app>"

# Set to "true" to show the sign-in link directly in the app's response even
# in production, instead of only emailing it - a deliberate escape hatch for
# running the real login flow (not SKIP_AUTH) before SMTP is set up, e.g.
# while it's still just you. Remove once SMTP is configured for real, and
# definitely before inviting anyone else in - anyone who submits an email
# gets a working sign-in link handed back with this on, no inbox needed.
SHOW_DEV_LINK=

# Required for Stage 3 (ingredient intelligence). Never expose this to the
# frontend — it is only ever read on the server.
ANTHROPIC_API_KEY=

# Optional. Comma-separated list of email addresses allowed to sign in.
# Set this while testing solo to keep the app closed to everyone else -
# anyone else who finds the login page gets a friendly "not open yet"
# message instead of being able to create an account. Leave blank/unset to
# open sign-in to anyone.
ALLOWED_EMAILS=

# Set to "true" to skip sign-in entirely during solo testing - every request
# acts as one fixed dev user and the login page is never shown. DEV_USER_EMAIL
# optionally names that user (defaults to dev@sknfolio.local). Turn this off
# (unset SKIP_AUTH) before inviting anyone else in.
SKIP_AUTH=
DEV_USER_EMAIL=
